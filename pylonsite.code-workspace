{
  "folders": [
    { "path": ".", "name": "pylonsite" },
    { "path": "shared-ui", "name": "shared-ui" },
    { "path": "shared-lint", "name": "shared-lint" },
    { "path": "shared-docs", "name": "shared-docs" },
    { "path": "shared-scripts", "name": "shared-scripts" },
    { "path": "site-sants-fitness", "name": "site-sants-fitness" },
    { "path": "site-keeping-busy-hvac", "name": "site-keeping-busy-hvac" }
  ],
  "settings": {
    "workbench.colorTheme": "Default Light Modern",
    "files.autoSave": "afterDelay",
    "git.autoRepositoryDetection": true,
    "git.detectSubmodules": true,
    "git.detectSubmodulesLimit": 20,
    "git.openRepositoryInParentFolders": "never",
    "git.repositoryScanMaxDepth": 2,
    "scm.repositories.visible": 15,
    "files.exclude": {
      "**/node_modules": true,
      "**/graphify-out": true,
      "**/__pycache__": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/.generated": true,
      "**/graphify-out": true,
      "**/__pycache__": true,
      "pnpm-lock.yaml": true
    }
  }
}
