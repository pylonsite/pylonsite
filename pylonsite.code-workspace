{
  "folders": [
    {
      "name": "pylonsite",
      "path": "."
    },
    {
      "name": "shared-ui",
      "path": "shared-ui"
    },
    {
      "name": "shared-lint",
      "path": "shared-lint"
    },
    {
      "name": "shared-docs",
      "path": "shared-docs"
    },
    {
      "name": "shared-scripts",
      "path": "shared-scripts"
    },
    {
      "name": "site-sants-fitness",
      "path": "site-sants-fitness"
    },
    {
      "name": "site-keeping-busy-hvac",
      "path": "site-keeping-busy-hvac"
    },
    {
      "name": "site-keeping-busy-hvac-live",
      "path": "site-keeping-busy-hvac-live"
    },
    {
      "name": "site-server",
      "path": "site-server"
    }
  ],
  "settings": {
    "workbench.colorTheme": "Default Light Modern",
    "files.autoSave": "afterDelay",
    "git.enabled": true,
    "git.autoRepositoryDetection": "openEditors",
    "git.detectSubmodules": false,
    "git.openRepositoryInParentFolders": "never",
    "git.repositoryScanMaxDepth": 1,
    "git.scanRepositories": [
      "site-keeping-busy-hvac",
      "site-keeping-busy-hvac-live",
      "site-sants-fitness",
      "shared-ui",
      "shared-lint",
      "shared-docs",
      "shared-scripts",
      "site-server"
    ],
    "scm.repositories.visible": 10,
    "files.exclude": {
      "**/node_modules": true,
      "**/graphify-out": true,
      "**/__pycache__": true,
      "**/.next": true,
      "**/dist": true,
      "**/.turbo": true
    },
    "files.watcherExclude": {
      "**/node_modules/**": true,
      "**/.git/objects/**": true,
      "**/.git/subtree-cache/**": true,
      "**/graphify-out/**": true,
      "**/.next/**": true,
      "**/dist/**": true,
      "**/.turbo/**": true,
      "**/pnpm-lock.yaml": true,
      "**/.cursor-server/**": true,
      "**/agent-transcripts/**": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/.generated": true,
      "**/graphify-out": true,
      "**/__pycache__": true,
      "**/.next": true,
      "**/dist": true,
      "pnpm-lock.yaml": true
    }
  }
}
