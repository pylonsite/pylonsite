node_modules/
.cache/
.generated/
*.log
.DS_Store
.env
.env.*

# Local live kits are their own git repos (siblings of site-*-live submodules).
# Registered submodule kits stay tracked via .gitmodules; this only hides ad-hoc kits.
/site-*-live/

# Append-only preflight / test-run log (also site-server/tests/.runs/history.jsonl)
.preflight-history.jsonl

# Graphify local knowledge-graph / AST cache (agent tooling)
graphify-out/
**/graphify-out/
__pycache__/

# Generated editor concat (source: site-server/platform/editor/js/*.js)
**/platform/editor/editor.js
**/platform/editor/editor.css
**/preview/editor/editor.js
**/preview/editor/editor.css
